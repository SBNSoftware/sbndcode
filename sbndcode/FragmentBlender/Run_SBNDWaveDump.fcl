#include "simulationservices_sbnd.fcl"
#include "backtrackerservice.fcl"
#include "particleinventoryservice.fcl"
#include "calorimetry_sbnd.fcl"
#include "rootoutput_sbnd.fcl"
process_name: WaveDumping

services: 
{
  FileCatalogMetadata:      @local::sbnd_file_catalog_mc
  TFileService:            { fileName: "hist_%p.root" }
  ParticleInventoryService: @local::standard_particleinventoryservice
                            @table::sbnd_services
}


physics:
{
  // now also have something produce the digits and headers
  analyzers:
  {
    WaveDumper: {
    module_type: "WaveDump"
    DataLabel: "daq::DECODE"
    }

  }

  producers: {}

  my_analyzer_modules: [WaveDumper]
  trigger_paths: []
  end_paths: [my_analyzer_modules]
}

source: {  module_type: RootInput }

outputs: {
  commissioning: {
    module_type: "RootOutput"
    fileName: "%ifb_WaveDump.root"
    dataTier: "reconstructed"
  }
}
