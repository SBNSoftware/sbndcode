# File: standard_detsim_sbnd_dnnroi_triton.fcl
#
# runs WC 2D signal processing during detsim using only DNN-based ROI finding,
# with DNN inference sent to a remote Triton server (TritonService, see
# wcls-sim-drift-depoflux-nf-sp.jsonnet) instead of local TorchService
# create one Wire product: simtpc2d:dnnsp

#include "standard_detsim_sbnd_dnnroi.fcl"

physics.producers.simtpc2d.wcls_main.plugins: [@sequence::sbnd_wcls_simsp_dnnroi.wcls_main.plugins, "WireCellTriton"]
