#include "prodgenie_corsika_proton_rockbox0p1_sbnd.fcl"

# Default channel list plus GENIE's CC single kaon, DIS-CC-SINGLEK.
# "Default+SingleKaon" is defined in GENIE/SingleKaon/EventGeneratorListAssembler.xml.
