#
# Cathode-filter stage -- DEPRECATED no-op pass-through.
#
# Historically this stage sat between standard_g4_rockbox_sbnd.fcl and
# standard_detsim_sbnd.fcl and ran the CathodeSimEnergyDepositFilter on
# the ionandscint SimEnergyDeposit collection (i.e. *after* the SCE
# shift had already been applied).
#
# The cathode is a physical surface at the un-shifted deposit position,
# so the filter has been moved up into standard_g4_rockbox_sbnd_cathodefilt.fcl
# where it now runs on the raw LArG4 SED *before* ionandscint applies
# SCE.  The filtered LArG4 deposits then flow through ionandscint and
# everything downstream sees only the surviving deposits.
#
# This file is kept as a no-op pass-through so existing job submission
# scripts that reference it continue to work: it just copies the input
# file to the output unchanged.  New chains should skip this stage.
#
# Chain:
#   gen                  -> prodgenie_corsika_proton_rockbox_sbnd_cathodefilt.fcl
#   g4                   -> standard_g4_rockbox_sbnd_cathodefilt.fcl   (filter runs HERE now)
#   filter               -> THIS FILE  (no-op, kept for compatibility) <--
#   detsim / reco / caf  -> standard_*_sbnd_cathodefilt.fcl
#

#include "services_sbnd.fcl"
#include "messages_sbnd.fcl"
#include "geometry_sbnd_cathodefilt.fcl"

process_name: CathodeFilter

services: {
  TFileService:              { fileName: "cathodefilter_hist.root" }
  TimeTracker:               {}
  MemoryTracker:             {}
  RandomNumberGenerator:     {}
  FileCatalogMetadata:       @local::sbnd_file_catalog_mc
  message:                   @local::sbnd_message_services_prod
  @table::sbnd_services
}

source: {
  module_type: RootInput
  maxEvents:   -1
}

# No producers -- the input file is already cathode-filtered by the g4
# stage.  Leave the trigger path empty so art simply streams events to
# the output unchanged.
physics: {
  producers: {}
  stream1:       [ out1 ]
  trigger_paths: []
  end_paths:     [ stream1 ]
}

outputs: {
  out1: {
    module_type: RootOutput
    fileName:    "%ifb_cathodefilt.root"
    dataTier:    "simulated"
    compressionLevel: 1
  }
}
