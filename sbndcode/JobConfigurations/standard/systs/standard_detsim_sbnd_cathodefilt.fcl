#
# Detsim stage for the cathode-filter chain.
#
# The CathodeSimEnergyDepositFilter now runs *inside* the g4 stage,
# before ionandscint.  That means by the time we get here:
#
#   * ionandscint            already contains only the surviving
#                            (post-cathode) deposits, with the SCE
#                            shift applied;
#   * ionandscint:priorSCE   ditto, with the un-shifted positions.
#
# So the standard SBND detsim labels (which read "ionandscint" /
# "ionandscint:priorSCE") work as-is -- we no longer need to remap
# every drift/photon producer onto a "cathodefiltered" label.
#
# The only cathode-specific bits left here are the WireCell config
# and the drift-velocity tweaks for the cathode-less geometry.
#

#include "standard_detsim_sbnd.fcl"
###include "geometry_sbnd_cathodefilt.fcl"

# ---- WireCell: use the no-cathode jsonnet -----------------------------
# The cathode-less geometry needs the matching WireCell config; the
# inputTag stays "ionandscint:" because that's the default SBND label.
physics.producers.simtpc2d.wcls_main.configs:["pgrapher/experiment/sbnd/wcls-sim-drift-depoflux-nf-sp_nocathode.jsonnet"]

# ---- Drift-velocity calibration for the cathode-less geometry ---------
services.DetectorPropertiesService.DriftVelFudgeFactor: 1.00767754319 #1.575/1.563
physics.producers.simtpc2d.wcls_main.structs.driftSpeed: 1.575
